        <mxCell id="n13" value="상승 상품 = 직전 비교일에 없던 신규 진입&#10;또는 직전 비교일보다 순위가 10위 이상 상승" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=21;fontColor=#172D46;fontStyle=1;" vertex="1" parent="n12">
