        </mxCell>
        <mxCell id="n25" value="앞 절반과 뒤 절반의 유형별 상품 수 평균 비교&#10;+15% 이상: 확대  /  −15% 이하: 축소&#10;그 사이: 유지&#10;4개 주간 관측 미만이면 방향 판단 자료가 부족함" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#61748A;fontStyle=0;" vertex="1" parent="n23">
          <mxGeometry x="24.0" y="66.0" width="588" height="121" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=0;fillColor=#F1F5FD;strokeColor=#D8E2F5;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="732" y="824" width="644" height="216" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="관측 요약 점수" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=23;fontColor=#172D46;fontStyle=1;" vertex="1" parent="n26">
          <mxGeometry x="24.0" y="17.0" width="596" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="추세 50%  +  연속 30%  +  분산 20%&#10;연속: 관측 기간 내 후보의 최대 연속 주 수&#10;분산: 마지막 주 상승 브랜드 수 / 유형 상품 수&#10;점수는 미래 유행 확률이 아니다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#61748A;fontStyle=0;" vertex="1" parent="n26">
          <mxGeometry x="24.0" y="66.0" width="596" height="121" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="동작 확인: 저장 관측에서 후보 목록과 계산값을 다시 만들 수 있는가?&#10;효과 확인: 탐지 정확도·업무 시간 절감은 아직 측정하지 않았으며, 완성률로 환산하지 않는다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=17;fontColor=#61748A;fontStyle=0;" vertex="1" parent="1">
