        </mxCell>
        <mxCell id="n20" value="나머지도 상태를 남긴다" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=22;fontColor=#172D46;fontStyle=1;" vertex="1" parent="n19">
