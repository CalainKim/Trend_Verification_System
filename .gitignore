# data
data/*.sqlite
# WAL 모드가 만드는 보조 파일. 실행 중에만 쓰이는 임시 상태이므로
# 저장소에 들어가면 안 된다. 커밋될 때마다 무의미한 변경이 생기고,
# 다른 사람이 받아 쓰면 DB 가 깨질 수 있다.
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
data/raw/
data/*.log
*.csv.gz

# secrets
.env
.env.local

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# os
.DS_Store

# 스냅샷은 소급 수집이 불가능한 원본이므로 반드시 커밋한다
!data/snapshots/
