# data
data/*.sqlite
# WAL 모드가 만드는 보조 파일. 실행 중에만 쓰이는 임시 상태이므로
# 저장소에 들어가면 안 된다. 커밋될 때마다 무의미한 변경이 생기고,
# 다른 사람이 받아 쓰면 DB 가 깨질 수 있다.
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
data/raw/
data/*.log
*.csv.gz

# secrets
.env
.env.local

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# os
.DS_Store

# 스냅샷은 소급 수집이 불가능한 원본이므로 반드시 커밋한다
!data/snapshots/

# Local monthly PoC responses and API credentials
private/
.env.*
!.env.example
.vscode/

# 보고서 빌드 중간 산출물
build/html/

# 보고서 산출물은 로컬에만 둔다
build/
docs/images/figures/
docs/report-figures.html

# 벤치마크 정답. 봉인한 것은 검증 파트가 보면 블라인드가 깨진다. 해시만 둔다.
#
#   benchmark/              봉인. 최종 숫자를 여기서 낸다 (커머스 139건)
#   benchmark-index/        봉인. 둘째 도메인 (검색 한국 207건)
#   benchmark-index-long/   공개. 검증 파트 연습용 (검색 장기 352건)
#
# 장기 쪽만 공개한 이유는 benchmark-index-long/LABELS.md 에 있다. 요약하면
# 커머스를 쪼개면 유의성을 잃고, 검증 파트가 혼자 채점할 수 없으면 반복이
# 막히기 때문이다. 셋 중 산업체 문제와 가장 먼 것을 내준다.
benchmark/labels.sealed.json
benchmark-index/labels.sealed.json

# 속성 매핑은 DB 와 사전에서 다시 만들 수 있다
data/attribute_map.csv

# 시간별 수집 로그
data/gtrends*.log
runs/

# wrangler 가 만드는 것. 2026-11-05 에 wrangler 가 스스로 덧붙였고 그대로 둔다.
# .dev.vars 는 로컬에서 중계 함수에 넣는 비밀값 파일이라 반드시 막아야 한다.
# .wrangler 는 캐시다.
.wrangler
.dev.vars*
!.dev.vars.example
