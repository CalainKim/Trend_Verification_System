        </mxCell>
        <mxCell id="n21" value="브랜드 단독  ·  상승 2개 이상, 최대 브랜드 점유 &gt; 50%&#10;신호 없음     ·  상승 상품 0개&#10;관찰            ·  위 조건에 해당하지 않는 나머지" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=17;fontColor=#61748A;fontStyle=0;" vertex="1" parent="n19">
          <mxGeometry x="24.0" y="63.0" width="630" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="03  한 주의 후보와 여러 주의 방향을 함께 보여준다" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=14;fontColor=#107E80;fontStyle=1;" vertex="1" parent="1">
