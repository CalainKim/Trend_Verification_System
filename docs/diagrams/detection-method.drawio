        <mxCell id="n10" value="남·여 상의 각 TOP100 → 같은 날 마지막 스냅샷 → 7일 목표 간격의 수집일 비교&#10;주간 추적은 목표 날짜와 3일 넘게 벌어지면 중단한다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#172D46;fontStyle=0;" vertex="1" parent="n9">
