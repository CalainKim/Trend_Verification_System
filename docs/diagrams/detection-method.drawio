        <mxCell id="n17" value="트렌드 후보" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=25;fontColor=#107E80;fontStyle=1;" vertex="1" parent="n16">
          <mxGeometry x="24.0" y="17.0" width="550" height="33" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="상승 상품 3개 이상  +  브랜드 3곳 이상&#10;최대 브랜드 점유율 50% 이하&#10;점유율의 분모: 해당 유형의 상승 상품 수" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=18;fontColor=#172D46;fontStyle=0;" vertex="1" parent="n16">
