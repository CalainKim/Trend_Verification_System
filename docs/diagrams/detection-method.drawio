        <mxCell id="n15" value="02  유형별로 후보 상태를 정한다" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=14;fontColor=#107E80;fontStyle=1;" vertex="1" parent="1">
