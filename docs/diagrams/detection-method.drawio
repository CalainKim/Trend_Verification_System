        <mxCell id="n6" value="계산 기준은 현재 코드의 시작 정책이다. 인터뷰에서 합의된 기준이나 예측 정확도를 뜻하지 않는다." style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=17;fontColor=#61748A;fontStyle=0;" vertex="1" parent="1">
