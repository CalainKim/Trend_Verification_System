        </mxCell>
        <mxCell id="n24" value="유형이 랭킹에서 차지하는 자리" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Malgun Gothic;fontSize=23;fontColor=#172D46;fontStyle=1;" vertex="1" parent="n23">
